  "screenshots": [
    {
      "src": "/screenshots/desktop-1280x800.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GitHub Clone desktop interface"
    },
    {
      "src": "/screenshots/mobile-375x667.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GitHub Clone mobile interface"
    },
    {
      "src": "/screenshots/tablet-768x1024.png",
      "sizes": "768x1024",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GitHub Clone tablet interface"
    }
  ],
  
  "related_applications": [],
  
  "prefer_related_applications": false,
  
  "protocol_handlers": [
    {
      "protocol": "web+githubclone",
      "url": "/?repo=%s"
    }
  ],
  
  "share_target": {
    "action": "/?share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "files",
          "accept": ["text/*", ".js", ".html", ".css", ".json", ".md", ".txt"]
        }
      ]
    }
  },
  
  "handle_links": "preferred",
  
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  
  "file_handlers": [
    {
      "action": "/?open-file",
      "accept": {
        "text/*": [".txt", ".md", ".js", ".html", ".css", ".json", ".xml", ".yml", ".yaml"],
        "application/json": [".json"],
        "application/javascript": [".js"]
      }
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 320
  },
  
  "permissions": [
    "clipboard-read",
    "clipboard-write",
    "file-system"
  ],
  
  "id": "/?source=pwa",
  
  "iarc_rating_id": "e10b8d4f-2b0a-4b1e-9b0a-9b9b0a9b0a9b"
}