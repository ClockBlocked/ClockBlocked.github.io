{
  "name": "GitHub Clone - Local File Manager",
  "short_name": "GitHub Clone",
  "description": "A professional GitHub-like file explorer and editor with local storage and offline capabilities",
  "start_url": "/",
  "scope": "/",
  
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "orientation": "any",
  "dir": "ltr",
  "lang": "en-US",
  
  "theme_color": "#22272e",
  "background_color": "#1c222b",
  
  "categories": [
    "development",
    "productivity",
    "utilities"
  ],
  
  "shortcuts": [
    {
      "name": "New Repository",
      "short_name": "New Repo",
      "description": "Create a new repository",
      "url": "/?new-repo",
      "icons": [
        {
          "src": "/icons/icon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New File",
      "short_name": "New File",
      "description": "Create a new file",
      "url": "/?new-file",
      "icons": [
        {
          "src": "/icons/icon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Recent Files",
      "short_name": "Recent",
      "description": "View recently opened files",
      "url": "/?recent",
      "icons": [
        {
          "src": "/icons/icon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
